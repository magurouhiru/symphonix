{
	"name": "@symphonix/server",
	"version": "0.0.1",
	"private": true,
	"description": "symphonix 本体（プランを立て、AI に実装させ、プレイヤーに書き出させる SvelteKit サーバー）",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "pnpm --filter @symphonix/player --filter symphonix-vscode build && vite dev --host",
		"build": "pnpm --filter @symphonix/player --filter symphonix-vscode build && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "tsc -b ../protocol && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"dependencies": {
		"@symphonix/protocol": "workspace:*"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"fflate": "^0.8.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	}
}
